{
  "name": "auditsoft-nkc",
  "productName": "AuditSoft",
  "version": "1.1.8",
  "private": true,
  "description": "Hệ thống Trợ lý Kiểm toán Toàn diện — Đối chiếu NKC, Bốc mẫu VSA 530 & Lập 12 Giấy làm việc",
  "author": "AuditSoft Team",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:vite": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "build:workers": "esbuild src/workers/reconcile.worker.ts src/workers/export.worker.ts --bundle --platform=node --target=node20 --outdir=dist-electron/workers",
    "build": "npm run build:vite && npm run build:node && npm run build:workers",
    "start": "electron .",
    "build:protect": "npm run build && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/compile-bytecode.mjs",
    "dist:protect": "npm run build:protect && electron-builder --win nsis portable -c.directories.output=dist-v118-release --publish never && node scripts/sync-installer.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:portable": "npm run build && electron-builder --win portable -c.directories.output=dist-v118-release --publish never && node scripts/sync-installer.mjs",
    "dist:setup": "npm run build && electron-builder --win nsis -c.directories.output=dist-v118-release --publish never && node scripts/sync-installer.mjs",
    "dist:all": "npm run build && electron-builder --win nsis portable -c.directories.output=dist-v118-release --publish never && node scripts/sync-installer.mjs",
    "keygen": "vite-node scripts/keygen.ts --",
    "keygen:app": "electron scripts/keygen-app.ts",
    "gen:icon": "node scripts/generateIcon.js",
    "release": "node scripts/publish-distribution.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.0",
    "bytenode": "^1.5.5",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "bytenode": "^1.6.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "vn.auditsoft.nkc",
    "productName": "AuditSoft",
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "GLV MAU",
        "to": "GLV MAU",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "B410",
        "to": "B410",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "AuditSoft-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AuditSoft",
      "artifactName": "AuditSoft-${version}-Setup.exe"
    }
  }
}
